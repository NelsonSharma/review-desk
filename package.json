{
  "name": "review-desk",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted literature review workspace",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node server/start.mjs",
    "start": "node server/start.mjs",
    "admin": "node scripts/admin.mjs",
    "backup": "node scripts/backup.mjs",
    "check": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "lucide-react": "1.73.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  }
}
